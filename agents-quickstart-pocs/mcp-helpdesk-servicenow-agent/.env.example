# Copy this file to .env in this directory and fill in your values.
# .env is git-ignored; never commit real credentials.

# Python interpreter of your servicenow-mcp install (it runs `-m servicenow_mcp.cli`).
# Linux/macOS example: /path/to/servicenow-mcp/.venv/bin/python
# Windows example:     C:\path\to\servicenow-mcp\.venv\Scripts\python.exe
SERVICENOW_MCP_COMMAND=

# Your ServiceNow instance and the user the agent acts as.
SERVICENOW_INSTANCE_URL=https://your-instance.service-now.com
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=

# Optional; defaults to basic.
# SERVICENOW_AUTH_TYPE=basic
