# AWS Configuration
# Credentials can also be loaded from ~/.aws/credentials
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key

# Server Configuration
# Bind address for server.py and two_party_server_fastapi.py. Defaults to
# 127.0.0.1 (this machine only). Set it to another address only when you mean
# to accept connections from elsewhere, for example SERVER_HOST=0.0.0.0 inside
# a container whose port is published to 127.0.0.1 on the host.
SERVER_HOST=127.0.0.1
SERVER_PORT=3001
TWO_PARTY_PORT=8082

# Nova Sonic Model
NOVA_SONIC_MODEL_ID=amazon.nova-2-5-sonic
