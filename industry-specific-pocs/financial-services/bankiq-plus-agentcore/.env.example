# AWS Configuration
AWS_DEFAULT_REGION=us-east-1
AGENTCORE_REGION=us-east-1

# Cognito Configuration (auto-populated by deployment)
# NOTE: Vite only exposes variables prefixed with VITE_ to the client build.
# (This app also ships a committed src/config.js with resolved values.)
VITE_AWS_REGION=us-east-1
VITE_USER_POOL_ID=us-east-1_XXXXXXXXX
VITE_USER_POOL_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX
VITE_COGNITO_DOMAIN=bankiq-auth-XXXXXXXXXXXX.auth.us-east-1.amazoncognito.com

# Backend Configuration
AGENTCORE_AGENT_ARN=arn:aws:bedrock-agentcore:us-west-2:XXXXXXXXXXXX:runtime/bank_iq_agent_v1-XXXXXXXXXX
UPLOADED_DOCS_BUCKET=bankiq-uploaded-docs-prod