# BankIQ+ Backend - ECS Fargate
FROM public.ecr.aws/docker/library/node:24-alpine

# Install Python3 and pip for PDF processing
RUN apk add --no-cache python3 py3-pip
RUN pip3 install --break-system-packages --no-cache-dir PyPDF2

# Set working directory
WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm install --production

# Copy application code
COPY server.js ./
COPY auth-middleware.js ./
COPY extract_pdf_metadata.py ./

# Listen on all interfaces inside the container so the ALB can reach the task.
# server.js defaults to 127.0.0.1 outside a container; the ECS security group
# only admits traffic from the ALB.
ENV HOST=0.0.0.0

# Expose port
EXPOSE 3001

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD node -e "require('http').get('http://127.0.0.1:3001/health', (r) => {process.exit(r.statusCode === 200 ? 0 : 1)})"

# Start server
CMD ["node", "server.js"]
